# AgentGuard Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./agentguard.db

# Security & Policies
DEFAULT_DAILY_LIMIT=200.00
DEFAULT_MAX_TRANSACTION=100.00
DEFAULT_AUTO_APPROVAL_LIMIT=50.00
DEFAULT_ALLOWED_MERCHANTS=TrustedStore,TechStore,VerifiedShop,OfficeSuppliesCo
DEFAULT_CURRENCY=USD

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Channel3 Product Discovery API
CHANNEL3_API_KEY=your_channel3_api_key
CHANNEL3_BASE_URL=https://api.channel3.ai

# AI Providers (Optional - deterministic fallbacks are always active)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DEFAULT_AI_PROVIDER=gemini
